# Ignore node_modules everywhere
**/node_modules/

# Ignore logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
**/*.log

# Ignore environment files
.env*
!.env.example

# Ignore build and cache artifacts
**/.next/
**/.next-verify*/
**/out/
**/build/
**/dist/
**/coverage/
**/.cache/
**/.vercel/
**/.turbo/
**/.parcel-cache/

# Ignore TypeScript incremental build info
**/*.tsbuildinfo

# Ignore package manager artifacts
.pnp
.pnp.js
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Ignore OS and editor metadata
.DS_Store
Thumbs.db
.vscode/
.idea/

# Ignore backend upload artifacts
backend/src/public/uploads/

# Ignore local agent/session runtime state
.claude/

# Locally-built frontend deploy bundles ARE committed on purpose: the server
# just `git pull`s and runs these instead of building on-box. Produced by
# `npm run build:deploy` (see deploy/package-standalone.mjs). These
# overrides must stay after the broad ignores above (node_modules, .next,
# etc.) since they live inside these folders too.
!/front-end/frontend-dist/
!/front-end/frontend-dist/**
!/front-end/admin-frontend-dist/
!/front-end/admin-frontend-dist/**
