# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/coffee-ecommrece

# Secret used to sign JWTs — use a long random value, never reuse across environments
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of phone numbers (10 digits) allowed to log in as admin
ADMIN_PHONE_NUMBERS=7434993463

# Server
PORT=5000
# Set to "production" in every real deployment. This gates several
# dev-only conveniences: OTP is echoed in API responses when NOT
# "production", and services/otpSender.js requires a real provider to be
# configured once it IS "production" (see that file).
NODE_ENV=development

# CORS: single origin, or a comma-separated list via CLIENT_URLS
CLIENT_URL=http://localhost:3000
CLIENT_URLS=

# OTP expiry, in minutes
OTP_EXPIRY_MINUTES=10

# Admin cookie tuning (optional — sane defaults are computed from NODE_ENV
# if left unset; see authController.js#getAdminCookieOptions)
ADMIN_COOKIE_SAME_SITE=lax
ADMIN_COOKIE_DOMAIN=

# pino log level (trace|debug|info|warn|error|fatal). Defaults to "debug" in
# dev / "info" in production if left unset (see utils/logger.js).
LOG_LEVEL=

# Razorpay payment gateway credentials (https://dashboard.razorpay.com/app/keys).
# Used by services/paymentService.js to create orders and verify payment
# signatures server-side — required for checkout to work at all.
RAZORPAY_KEY_ID=change-me
RAZORPAY_KEY_SECRET=change-me

# Shiprocket shipping integration (https://app.shiprocket.in — Settings > API).
# Use a dedicated API user's credentials (Settings > API > create API User),
# not your main Shiprocket login — services/shiprocketService.js logs in
# with these once and caches the bearer token in memory (~9 days; Shiprocket
# tokens are valid 10 days).
SHIPROCKET_EMAIL=change-me
SHIPROCKET_PASSWORD=change-me
# Exact pickup location "nickname" configured under Settings > Pickup
# Addresses in the Shiprocket dashboard — required on every order-create call.
SHIPROCKET_PICKUP_LOCATION=Primary
# The "Webhook Secret" you set under Settings > API > Webhook in Shiprocket's
# dashboard (alongside the webhook URL, https://<your-api-domain>/api/webhooks/shiprocket).
# Verified against the X-Api-Key header on every incoming webhook call — see
# controllers/webhookController.js. Treat as sensitive; must match exactly.
SHIPROCKET_WEBHOOK_SECRET=change-me
