# Base URL of the backend API. If unset, the app silently falls back to
# http://localhost:5000/api — always set this explicitly outside local dev.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Public URL this site is deployed at. Used for SEO metadata (Open Graph
# absolute URLs, sitemap.ts, robots.ts) — always set this explicitly outside
# local dev, or generated URLs will point at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Razorpay publishable key id — safe to expose client-side. Must match
# RAZORPAY_KEY_ID in the backend's .env or payment verification will fail
# server-side. Not currently read by app code (the checkout flow gets the
# key id from the backend's /orders/razorpay/order response instead) — kept
# here for reference/future use.
NEXT_PUBLIC_RAZORPAY_KEY_ID=change-me
